FROM node:24.8.0-alpine3.22 AS frontend
WORKDIR /src
COPY package.json package-lock.json ./
RUN npm ci
COPY ui/assets/input.css ./ui/assets/input.css
COPY cmd/panel ./cmd/panel
RUN npm run build

FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
COPY --from=frontend /src/ui/assets/app.css /src/ui/assets/app.css
COPY --from=frontend /src/ui/assets/htmx.min.js /src/ui/assets/htmx.min.js
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/panel ./cmd/panel

FROM alpine:3.22
RUN apk add --no-cache ca-certificates su-exec && addgroup -g 10001 -S panel && adduser -u 10001 -S -G panel panel
COPY --from=build /out/panel /usr/local/bin/panel
COPY deploy/panel-entrypoint.sh /usr/local/bin/panel-entrypoint
RUN chmod +x /usr/local/bin/panel-entrypoint
ENTRYPOINT ["/usr/local/bin/panel-entrypoint"]
