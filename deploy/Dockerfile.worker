FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/worker ./cmd/worker

FROM alpine:3.22 AS storage-probe
RUN apk add --no-cache build-base linux-headers xfsprogs-dev util-linux-dev
COPY deploy/storage-probe.c /src/storage-probe.c
COPY deploy/storage-inventory.h deploy/storage-common.h deploy/storage-authority.c deploy/storage-tagging.h /src/
RUN cc -std=c11 -Wall -Wextra -Werror -O2 -static /src/storage-probe.c -o /storage-probe && cc -std=c11 -Wall -Wextra -Werror -O2 -static /src/storage-authority.c -o /storage-authority

FROM docker:cli
RUN apk add --no-cache docker-cli-compose ca-certificates
COPY --from=build /out/worker /usr/local/bin/worker
COPY --from=storage-probe /storage-probe /usr/local/bin/storage-probe
COPY --from=storage-probe /storage-authority /usr/local/bin/storage-authority
ENTRYPOINT ["/usr/local/bin/worker"]
