{
  "name": "panel4wp-frontend",
  "private": true,
  "scripts": {
    "build": "npm run build:css && npm run build:assets",
    "build:css": "tailwindcss -i ./ui/assets/input.css -o ./ui/assets/app.css --minify",
    "build:assets": "mkdir -p ./ui/assets/fonts && cp ./node_modules/htmx.org/dist/htmx.min.js ./ui/assets/htmx.min.js && cp ./node_modules/@fontsource-variable/vazirmatn/files/vazirmatn-arabic-wght-normal.woff2 ./ui/assets/fonts/vazirmatn-arabic-wght-normal.woff2"
  },
  "dependencies": {
    "htmx.org": "2.0.11"
  },
  "devDependencies": {
    "@fontsource-variable/vazirmatn": "^5.3.0",
    "@tailwindcss/cli": "4.3.3",
    "tailwindcss": "4.3.3"
  }
}
