package main

import (
	"fmt"
 "strconv"
	"net/url"

	"github.com/kazemsoft/panel4wp/internal/core"
)

templ languageSwitcher(lang, currentPath string, languages []languageOption, t func(string) string) {
	<form class="language-switcher" action="/language" method="get">
		<input type="hidden" name="next" value={ currentPath }/>
		<label for="language-select">{ t("language") }</label>
		<select id="language-select" name="lang" onchange="this.form.submit()" aria-label={ t("language") }>
			for _, option := range languages {
				<option value={ option.Code } selected?={ option.Code == lang }>{ option.Name }</option>
			}
		</select>
		<noscript><button class="secondary language-submit" type="submit">@icon("check")<span class="button-label">{ t("apply") }</span></button></noscript>
	</form>
}

templ icon(name string) {
	<svg class={ "icon icon-" + name } aria-hidden="true" viewBox="0 0 24 24">
		switch name {
			case "login":
				<path d="M10 17l5-5-5-5"></path><path d="M15 12H3"></path><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path>
			case "logout":
				<path d="M14 8l4 4-4 4"></path><path d="M18 12H7"></path><path d="M10 4H5a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h5"></path>
			case "sites":
				<rect x="3" y="3" width="7" height="7" rx="1"></rect><rect x="14" y="3" width="7" height="7" rx="1"></rect><rect x="3" y="14" width="7" height="7" rx="1"></rect><rect x="14" y="14" width="7" height="7" rx="1"></rect>
			case "settings":
				<path d="M4 7h10"></path><path d="M18 7h2"></path><circle cx="16" cy="7" r="2"></circle><path d="M4 17h2"></path><path d="M10 17h10"></path><circle cx="8" cy="17" r="2"></circle>
			case "activity":
				<circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path>
			case "roadmap":
				<path d="m12 3 1.2 3.1L16 7.5l-2.8 1.4L12 12l-1.2-3.1L8 7.5l2.8-1.4L12 3Z"></path><path d="m18.5 13 .8 2 1.7.8-1.7.9-.8 2.1-.8-2.1-1.7-.9 1.7-.8.8-2Z"></path><path d="m5.5 14 .8 2 1.7.8-1.7.9-.8 2.1-.8-2.1-1.7-.9 1.7-.8.8-2Z"></path>
			case "plus":
				<path d="M12 5v14"></path><path d="M5 12h14"></path>
			case "manage":
				<circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1-2.8 2.8-.1-.1a1.7 1.7 0 0 0-1.9-.3 1.7 1.7 0 0 0-1 1.6v.2h-4V21a1.7 1.7 0 0 0-1-1.6 1.7 1.7 0 0 0-1.9.3l-.1.1L4.2 17l.1-.1a1.7 1.7 0 0 0 .3-1.9A1.7 1.7 0 0 0 3 14H2.8v-4H3a1.7 1.7 0 0 0 1.6-1 1.7 1.7 0 0 0-.3-1.9L4.2 7 7 4.2l.1.1A1.7 1.7 0 0 0 9 4.6 1.7 1.7 0 0 0 10 3V2.8h4V3a1.7 1.7 0 0 0 1 1.6 1.7 1.7 0 0 0 1.9-.3l.1-.1L19.8 7l-.1.1a1.7 1.7 0 0 0-.3 1.9 1.7 1.7 0 0 0 1.6 1h.2v4H21a1.7 1.7 0 0 0-1.6 1Z"></path>
			case "dashboard":
				<rect x="3" y="3" width="18" height="18" rx="2"></rect><path d="M9 3v18"></path><path d="M9 9h12"></path>
			case "backup":
				<path d="M4 7h16v13H4z"></path><path d="M3 3h18v4H3z"></path><path d="M9 12h6"></path>
			case "refresh":
				<path d="M20 11a8 8 0 0 0-14.9-4L3 10"></path><path d="M3 4v6h6"></path><path d="M4 13a8 8 0 0 0 14.9 4L21 14"></path><path d="M21 20v-6h-6"></path>
			case "database":
				<ellipse cx="12" cy="5" rx="8" ry="3"></ellipse><path d="M4 5v7c0 1.7 3.6 3 8 3s8-1.3 8-3V5"></path><path d="M4 12v7c0 1.7 3.6 3 8 3s8-1.3 8-3v-7"></path>
			case "files":
				<path d="M3 6a2 2 0 0 1 2-2h5l2 3h7a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6Z"></path>
			case "stop":
				<rect x="6" y="6" width="12" height="12" rx="2"></rect>
			case "play":
				<path d="m8 5 11 7-11 7V5Z"></path>
			case "mail":
				<rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m4 7 8 6 8-6"></path>
			case "trash":
				<path d="M4 7h16"></path><path d="M10 11v6"></path><path d="M14 11v6"></path><path d="m6 7 1 14h10l1-14"></path><path d="M9 7V4h6v3"></path>
			case "restore":
				<path d="M3 12a9 9 0 1 0 3-6.7L3 8"></path><path d="M3 3v5h5"></path><path d="M12 7v5l3 2"></path>
			case "download":
				<path d="M12 3v12"></path><path d="m7 10 5 5 5-5"></path><path d="M4 21h16"></path>
			case "upload":
				<path d="M12 16V4"></path><path d="m7 9 5-5 5 5"></path><path d="M4 20h16"></path>
			case "folder-plus":
				<path d="M3 6a2 2 0 0 1 2-2h5l2 3h7a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6Z"></path><path d="M12 11v6"></path><path d="M9 14h6"></path>
			case "arrow-left":
				<path d="m15 18-6-6 6-6"></path><path d="M9 12h11"></path>
			case "arrow-up":
				<path d="m6 10 6-6 6 6"></path><path d="M12 4v16"></path>
			case "check":
				<path d="m5 12 4 4L19 6"></path>
			case "close":
				<path d="M6 6l12 12"></path><path d="M18 6 6 18"></path>
			case "copy":
				<rect x="8" y="8" width="11" height="11" rx="2"></rect><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"></path>
			case "move":
				<path d="M12 3v18"></path><path d="m8 7 4-4 4 4"></path><path d="m8 17 4 4 4-4"></path><path d="M3 12h18"></path><path d="m7 8-4 4 4 4"></path><path d="m17 8 4 4-4 4"></path>
			case "open":
				<path d="M5 12h14"></path><path d="m13 6 6 6-6 6"></path>
			case "file":
				<path d="M6 2h8l4 4v16H6z"></path><path d="M14 2v5h5"></path>
			case "link":
				<path d="M10 13a5 5 0 0 0 7.5.5l2-2a5 5 0 0 0-7-7l-1.1 1.1"></path><path d="M14 11a5 5 0 0 0-7.5-.5l-2 2a5 5 0 0 0 7 7l1.1-1.1"></path>
			case "panel-close":
				<rect x="3" y="4" width="18" height="16" rx="2"></rect><path d="M9 4v16"></path><path d="m15 9-3 3 3 3"></path>
			case "panel-open":
				<rect x="3" y="4" width="18" height="16" rx="2"></rect><path d="M9 4v16"></path><path d="m13 9 3 3-3 3"></path>
		}
	</svg>
}

templ logoMark() {
	<span class="brand-mark" aria-hidden="true"><svg viewBox="0 0 40 40" fill="none"><circle cx="20" cy="20" r="17.5" fill="#4355d6"></circle><circle cx="20" cy="20" r="13" stroke="white" stroke-width="1.5" opacity=".55"></circle><path d="M15.5 29V11.5h6.2a6 6 0 0 1 0 12h-6.2m0-7h5.7a1 1 0 0 1 0 2h-5.7" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"></path></svg></span>
}

templ brand() {
	<a class="brand" href="/">@logoMark()<span class="brand-name">panel4wp</span></a>
}

templ sidebar(language, currentPath string, languages []languageOption, t func(string) string, csrf, pageName string) {
	<aside class="sidebar" id="app-sidebar">
		<div class="sidebar-header">@brand()<button class="sidebar-toggle secondary" type="button" data-sidebar-toggle data-collapse-label={ t("collapse_sidebar") } data-expand-label={ t("expand_sidebar") } aria-controls="app-sidebar" aria-expanded="true">@icon("panel-close")@icon("panel-open")</button></div>
		<nav>
			<div class="eyebrow">{ t("workspace") }</div>
			<a class={ templ.Classes("nav-link", templ.KV("active", isSitePage(pageName))) } href="/" title={ t("my_sites") }>@icon("sites")<span class="nav-label">{ t("my_sites") }</span></a>
			<a class={ templ.Classes("nav-link", templ.KV("active", pageName == "settings")) } href="/settings" title={ t("settings") }>@icon("settings")<span class="nav-label">{ t("settings") }</span></a>
			<a class={ templ.Classes("nav-link", templ.KV("active", pageName == "activity")) } href="/activity" title={ t("activity") }>@icon("activity")<span class="nav-label">{ t("activity") }</span></a>
			<a class={ templ.Classes("nav-link", "roadmap-nav", templ.KV("active", pageName == "roadmap")) } href="/roadmap" title={ t("whats_next") }>@icon("roadmap")<span class="nav-label">{ t("whats_next") }</span></a>
		</nav>
		<div class="sidebar-footer">
			@languageSwitcher(language, currentPath, languages, t)
			@githubCTA(t)
			<form action="/logout" method="post"><input type="hidden" name="csrf" value={ csrf }/><button class="secondary" title={ t("log_out") }>@icon("logout")<span class="button-label">{ t("log_out") }</span></button></form>
		</div>
	</aside>
}

templ githubCTA(t func(string) string) {
	<a class="github-cta" href="https://github.com/kazemsoft/panel4wp" target="_blank" rel="noopener">
		<svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.18-3.37-1.18-.45-1.15-1.11-1.46-1.11-1.46-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.89 1.52 2.34 1.08 2.91.83.09-.64.35-1.08.64-1.33-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.99 1.03-2.69-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.03a9.58 9.58 0 0 1 5 0c1.91-1.3 2.75-1.03 2.75-1.03.55 1.38.2 2.4.1 2.65.64.7 1.03 1.6 1.03 2.69 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.58c0 .27.18.58.69.48A10 10 0 0 0 12 2Z"></path></svg>
		<strong>{ t("github_star_title") }</strong>
		<small>{ t("github_star_help") }</small>
	</a>
}

templ documentHead(v view) {
	<head>
		<meta charset="utf-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1"/>
		<title>panel4wp · { v.T("workspace") }</title>
		<link rel="stylesheet" href="/assets/app.css?v=11"/>
		<script src="/assets/htmx.min.js?v=7" defer></script>
		<script src="/assets/app.js?v=10" defer></script>
	</head>
}

templ page(v view) {
	<!doctype html>
	<html lang={ v.Language } dir={ v.Direction }>
		@documentHead(v)
		<body>
			if v.LoggedIn {
				@appShell(v)
			} else {
				@loginPage(v)
			}
		</body>
	</html>
}

templ loginPage(v view) {
	<div class="login-language">@languageSwitcher(v.Language, v.CurrentPath, v.Languages, v.T)</div>
	<div class="login-layout">
		<section class="login-card">
			@brand()
			<div class="eyebrow">{ v.T("workspace") }</div>
			<h1>{ v.T("welcome_back") }</h1>
			<p class="muted">{ v.T("login_guide") }</p>
			@alerts(v.Error, v.Message)
			<form action="/login" method="post">
				<label>{ v.T("administrator_password") }<input type="password" name="password" autocomplete="current-password" required autofocus/></label>
				<button>@icon("login")<span class="button-label">{ v.T("log_in") }</span></button>
			</form>
			<p class="hint login-note">{ v.T("private_control") }</p>
		</section>
	</div>
}

templ appShell(v view) {
	<div class="shell">
		@sidebar(v.Language, v.CurrentPath, v.Languages, v.T, v.CSRF, v.Page)
					<div class="workspace">
						<header class="topbar"><div><div class="eyebrow">{ v.T("overview") }</div><h1>{ v.PageTitle }</h1><p>{ v.Guide }</p></div><span class="admin-chip"><span class="dot"></span>{ v.T("administrator") }</span></header>
						@alerts(v.Error, v.Message)
						if v.Page == "dashboard" {
							@dashboardMetrics(v)
						}
						<main class="page-content">
							switch v.Page {
								case "new":
									@newSite(v)
								case "dashboard", "site", "backups", "updates", "database", "resources":
									@sites(v)
								case "settings":
									@settingsPage(v)
								case "activity":
									@activityPage(v)
								case "roadmap":
									@roadmapPage(v)
							}
						</main>
						<p class="hint">panel4wp · { v.T("built_for_hosting") }</p>
					</div>
				</div>
}

templ alerts(err, message string) {
	if err != "" {
		<p class="error" role="alert">{ err }</p>
	}
	if message != "" {
		<p class="success" role="status">{ message }</p>
	}
}

templ dashboardMetrics(v view) {
	<div class="overview">
		<div class="metric"><span>{ v.T("managed_sites") }</span><strong>{ len(v.Sites) }</strong></div>
		<div class="metric"><span>{ v.T("hosting_environment") }</span><strong>{ v.T("your_server") }</strong></div>
		<div class="metric"><span>{ v.T("workspace_access") }</span><strong>{ v.T("single_administrator") }</strong></div>
	</div>
}

templ newSite(v view) {
	<section id="create-site" class="form-card">
		<div class="eyebrow">{ v.T("new_workspace") }</div><h2>{ v.T("create_site") }</h2><p class="hint">{ v.T("create_site_hint") }</p>
		@capacityOverview(v)
		<form action="/sites" method="post" data-disable-on-submit data-progress-label={ v.T("in_progress") }><input type="hidden" name="csrf" value={ v.CSRF }/>
			<label>{ v.T("domain") }<input name="domain" placeholder="example.com"/></label>
			<label>{ v.T("site_title") }<input name="title" required maxlength="120"/></label>
			<label>{ v.T("wordpress_admin_email") }<input type="email" name="email" required/></label>
			@resourceFields(v, core.Resources{MemoryMB:768,CPUs:1})
			<p><button disabled?={ v.Capacity == nil }>@icon("plus")<span class="button-label">{ v.T("create_site") }</span></button></p>
		</form><small>{ v.T("local_domain_hint") }</small>
	</section>
}

templ sites(v view) {
	<section class="sites-section" id="sites">
		<div class="section-head"><div><h2>
			if v.Page == "dashboard" {
				{ v.T("your_sites") } <span class="badge">{ len(v.Sites) }</span>
			} else {
				{ v.T("site_workspace") }
			}
		</h2></div>
		@actionForm(v.CSRF, "/reconcile?next="+url.QueryEscape(v.CurrentPath), "secondary", "refresh", v.T("refresh_status"), v.T("in_progress"))
		if v.Page == "dashboard" {
			<a class="button" href="/sites/new">@icon("plus")<span class="button-label">{ v.T("add_site") }</span></a>
		} else {
			<a class="icon-link" href={ templ.URL("/sites/" + v.SelectedID + "?stats=1") }>@icon("refresh")<span>{ v.T("refresh_usage") }</span></a>
		}</div>
		if len(v.Sites) == 0 {
			<div class="empty"><h3>{ v.T("first_site_title") }</h3><p>{ v.T("first_site_help") }</p><a href="/sites/new">{ v.T("create_first_site") } →</a></div>
		} else {
			if v.StatsError != "" {
				<p class="error">{ v.StatsError }</p>
			}
			for _, site := range v.Sites {
				@siteCard(v, site)
			}
		}
	</section>
}

templ siteCard(v view, site core.Site) {
	{{ stats := v.Stats[site.ID] }}
	{{ storage, hasStorage := v.Storage[site.ID] }}
	<article class="card site-card">
		<div class="site-head"><div class="site-icon">W</div><div class="site-meta"><h3>{ site.Title }</h3><a href={ templ.URL(sitePublicURL(site.Domain)) } target="_blank" rel="noopener">{ site.Domain }</a><small>{ site.ID } · { fmt.Sprintf("%d MB · %g CPU", site.MemoryMB, site.CPUs) }</small></div><div class="site-status"><span class={ "badge " + visibleStatus(site) }>{ v.T("status_" + visibleStatus(site)) }</span>
			if v.Page == "site" && site.Status == core.StatusRunning && !operationPending(site) && site.HealthError == "" {
				@actionForm(v.CSRF, "/sites/"+site.ID+"/stop", "secondary status-action", "stop", v.T("stop"), v.T("in_progress"))
			}
			if v.Page == "site" && (site.Status == core.StatusStopped || site.Status == core.StatusUnhealthy) && !operationPending(site) && site.HealthError == "" {
				@actionForm(v.CSRF, "/sites/"+site.ID+"/start", "status-action", "play", v.T("start"), v.T("in_progress"))
			}
		</div></div>
		<div class="site-details">
			if stats.WordPress != nil || stats.Database != nil {
				<details><summary>{ v.T("live_resource_usage") }</summary>
					if stats.WordPress != nil {
						<p><small><strong>WordPress</strong> · CPU { stats.WordPress.CPU } · { v.T("memory") } { stats.WordPress.Memory } ({ stats.WordPress.MemoryPC }) · { v.T("network") } { stats.WordPress.NetIO } · { v.T("disk_io") } { stats.WordPress.BlockIO } · PIDs { stats.WordPress.PIDs }</small></p>
					}
					if stats.Database != nil {
						<p><small><strong>{ v.T("database") }</strong> · CPU { stats.Database.CPU } · { v.T("memory") } { stats.Database.Memory } ({ stats.Database.MemoryPC }) · { v.T("network") } { stats.Database.NetIO } · { v.T("disk_io") } { stats.Database.BlockIO } · PIDs { stats.Database.PIDs }</small></p>
					}
					if hasStorage {
						<p><small><strong>{ v.T("storage") }</strong> · WordPress { formatBytes(storage.WordPressBytes) } · { v.T("database") } { formatBytes(storage.DatabaseBytes) } · { v.T("backups") } { formatBytes(storage.BackupBytes) }</small></p>
					}
				</details>
			}
			if !site.HealthCheckedAt.IsZero() {
 <p class="hint">{ v.T("status_checked") }: { formatTime(site.HealthCheckedAt) }</p>
 }
			if site.HealthError != "" {
 <p class="error">{ v.T("status_unavailable") }</p>
 }
			if operationPending(site) {
 <p class="hint">{ v.T("operation_pending") }</p>
 }
			if site.Error != "" {
				<p class="error">{ site.Error }</p>
			}
		</div>
		if v.Page == "dashboard" {
			<div class="site-actions"><a class="button secondary" href={ templ.URL("/sites/" + site.ID) }>@icon("manage")<span class="button-label">{ v.T("manage_site") }</span></a></div>
		} else {
			@siteWorkspace(v, site)
		}
	</article>
}

templ siteWorkspace(v view, site core.Site) {
	<div class="site-actions">
		<a class="button secondary" href={ templ.URL("/sites/" + site.ID + "/resources") }>@icon("settings")<span class="button-label">{ v.T("resources_title") }</span></a>
		<a class="button secondary" href={ templ.URL("/sites/" + site.ID) }>@icon("dashboard")<span class="button-label">{ v.T("overview") }</span></a><a class="button secondary" href={ templ.URL("/sites/" + site.ID + "/backups") }>@icon("backup")<span class="button-label">{ v.T("backups") }</span></a><a class="button secondary" href={ templ.URL("/sites/" + site.ID + "/updates") }>@icon("refresh")<span class="button-label">{ v.T("updates") }</span></a><a class="button secondary" href={ templ.URL("/sites/" + site.ID + "/database") }>@icon("database")<span class="button-label">{ v.T("database") }</span></a><a class="button secondary" href={ templ.URL("/sites/" + site.ID + "/files") }>@icon("files")<span class="button-label">{ v.T("files") }</span></a>
	</div>
	<div class="site-actions">
		if v.Page == "backups" && site.Status == core.StatusRunning && !operationPending(site) && site.HealthError == "" {
			@actionForm(v.CSRF, "/sites/"+site.ID+"/backup", "", "backup", v.T("backup_now"), v.T("in_progress"))
		}
		if v.Page == "updates" && site.Status == core.StatusRunning && !operationPending(site) && site.HealthError == "" {
			@actionForm(v.CSRF, "/sites/"+site.ID+"/update", "secondary", "refresh", v.T("update_wordpress"), v.T("in_progress"))
		}
		if v.Page == "database" && site.Status == core.StatusRunning && !operationPending(site) && site.HealthError == "" {
			@actionForm(v.CSRF, "/sites/"+site.ID+"/database-start", "secondary", "database", v.T("open_database_manager"), v.T("in_progress"))
			<small>{ v.T("database_access_hint") }</small>
		}
		if v.Page == "site" && site.Status == core.StatusFailed && !operationPending(site) {
			@actionForm(v.CSRF, "/sites/"+site.ID+"/retry", "", "refresh", v.T("retry"), v.T("in_progress"))
		}
	</div>
	<div class="site-details">
		if v.Page == "resources" {
 @siteResourcesForm(v,site)
 }
		if v.Page == "backups" {
			@backupSchedule(v, site)
			if len(site.Backups) > 0 {
				@backupList(v, site)
			}
		}
		if v.Page == "site" {
			@siteMail(v, site)
			@deleteSite(v, site)
		}
	</div>
}

templ backupSchedule(v view, site core.Site) {
	<section class="backup-schedule">
		<div class="roadmap-head"><h3>{ v.T("backup_schedule_title") }</h3>
			if site.BackupPolicy.Enabled {
				<span class="badge running">{ v.T("enabled") }</span>
			} else {
				<span class="badge">{ v.T("disabled") }</span>
			}
		</div>
		<p class="hint">{ v.T("backup_schedule_hint") }</p>
		<form action={ "/sites/" + site.ID + "/backup-schedule" } method="post">
			<input type="hidden" name="csrf" value={ v.CSRF }/>
			<label class="checkbox-label"><input type="checkbox" name="enabled" checked?={ site.BackupPolicy.Enabled }/> { v.T("enable_backup_schedule") }</label>
			<div class="schedule-grid">
				<label>{ v.T("backup_frequency") }<select name="interval_hours"><option value="6" selected?={ backupIntervalValue(site.BackupPolicy) == 6 }>{ v.T("every_6_hours") }</option><option value="12" selected?={ backupIntervalValue(site.BackupPolicy) == 12 }>{ v.T("every_12_hours") }</option><option value="24" selected?={ backupIntervalValue(site.BackupPolicy) == 24 }>{ v.T("daily") }</option><option value="168" selected?={ backupIntervalValue(site.BackupPolicy) == 168 }>{ v.T("weekly") }</option></select></label>
				<label>{ v.T("retention_count") }<input type="number" name="retention" min="1" max="30" value={ fmt.Sprintf("%d", backupRetentionValue(site.BackupPolicy)) }/><small>{ v.T("retention_hint") }</small></label>
			</div>
			<div class="schedule-status"><span><strong>{ v.T("next_backup") }</strong>{ formatOptionalTime(site.BackupPolicy.NextRunAt, v.T("not_scheduled")) }</span><span><strong>{ v.T("last_successful_backup") }</strong>{ formatOptionalTime(site.BackupPolicy.LastSuccessAt, v.T("never")) }</span></div>
			if site.BackupPolicy.LastError != "" {
				<p class="error schedule-error">{ site.BackupPolicy.LastError }</p>
			}
			<button class="form-submit">@icon("check")<span class="button-label">{ v.T("save_backup_schedule") }</span></button>
		</form>
	</section>
}

templ actionForm(csrf, action, className, iconName, label, progressLabel string) {
	<form class="inline" action={ action } method="post" data-disable-on-submit data-progress-label={ progressLabel }><input type="hidden" name="csrf" value={ csrf }/><button class={ className }>@icon(iconName)<span class="button-label">{ label }</span></button></form>
}

templ backupList(v view, site core.Site) {
	<section class="backup-list"><div class="backup-list-head"><div><h3>{ v.T("backups_recovery") }</h3><p class="hint">{ v.T("restore_warning") }</p></div><span class="badge">{ fmt.Sprintf("%d %s", len(site.Backups), v.T("available")) }</span></div>
		<div class="table-wrap"><table class="backup-table"><thead><tr><th>{ v.T("created_at") }</th><th>ID</th><th>{ v.T("type") }</th><th>{ v.T("actions") }</th></tr></thead><tbody>
		for _, backup := range site.Backups {
			<tr><td><time>{ formatTime(backup.CreatedAt) }</time></td><td><code>{ backup.ID }</code></td><td><span class="badge">{ v.T(backupSourceKey(backup.Source)) }</span></td><td><div class="backup-row-actions"><button class="secondary icon-button" type="button" data-modal-open={ "restore-" + backup.ID } aria-label={ v.T("restore_backup") } title={ v.T("restore_backup") }>@icon("restore")</button><button class="danger icon-button" type="button" data-modal-open={ "delete-" + backup.ID } aria-label={ v.T("delete_backup") } title={ v.T("delete_backup") }>@icon("trash")</button></div></td></tr>
		}
		</tbody></table></div>
		for _, backup := range site.Backups {
			@backupConfirmDialog(v, site, backup, "restore")
			@backupConfirmDialog(v, site, backup, "delete")
		}
	</section>
}

templ backupConfirmDialog(v view, site core.Site, backup core.Backup, operation string) {
	{{ isRestore := operation == "restore" }}
	{{ dialogID := operation + "-" + backup.ID }}
	{{ action := "/sites/" + site.ID + "/backup-delete" }}
	{{ title := v.T("delete_backup") }}
	{{ warning := v.T("delete_backup_warning") }}
	{{ iconName := "trash" }}
	if isRestore {
		{{ action = "/sites/" + site.ID + "/restore" }}
		{{ title = v.T("restore_backup") }}
		{{ warning = v.T("restore_warning") }}
		{{ iconName = "restore" }}
	}
	<dialog id={ dialogID } class="confirm-dialog" aria-labelledby={ dialogID + "-title" }>
		<div class="dialog-header"><div class="dialog-title">@icon(iconName)<h3 id={ dialogID + "-title" }>{ title }</h3></div><button class="secondary icon-button" type="button" data-modal-close aria-label={ v.T("cancel") }>@icon("close")</button></div>
		<p class="dialog-warning">{ warning }</p>
		<form action={ action } method="post" data-confirm-domain={ site.Domain } data-disable-on-submit data-progress-label={ v.T("in_progress") }>
			<input type="hidden" name="csrf" value={ v.CSRF }/><input type="hidden" name="backup_id" value={ backup.ID }/>
			<label for={ dialogID + "-confirm" }>{ v.T("confirm_domain") }</label><span class="domain-copy"><code class="confirmation-domain">{ site.Domain }</code><button class="secondary copy-domain" type="button" data-copy-text={ site.Domain } title={ v.T("copy") }>@icon("copy")<span>{ v.T("copy") }</span></button></span><input id={ dialogID + "-confirm" } name="confirm" required autocomplete="off" spellcheck="false" data-confirm-input/>
			<div class="dialog-actions"><button class="secondary" type="button" data-modal-close>{ v.T("cancel") }</button><button class="danger" type="submit" data-confirm-submit disabled>@icon(iconName)<span class="button-label">{ title }</span></button></div>
		</form>
	</dialog>
}

templ siteMail(v view, site core.Site) {
	<details><summary>{ v.T("outgoing_email") }
		if site.MailEnabled {
			<span class="badge running">{ v.T("enabled") }</span>
		}
	</summary><p class="hint">{ v.T("smtp_site_hint") }</p>
		if site.Status == core.StatusRunning && !operationPending(site) && site.HealthError == "" {
			<form action={ "/sites/" + site.ID + mailAction(site.MailEnabled) } method="post"><input type="hidden" name="csrf" value={ v.CSRF }/><button class="secondary">@icon("mail")<span class="button-label">
				if site.MailEnabled {
					{ v.T("disable_smtp") }
				} else {
					{ v.T("enable_global_smtp") }
				}
			</span></button></form>
		} else {
			<p class="hint">{ v.T("start_before_mail") }</p>
		}
	</details>
}

templ deleteSite(v view, site core.Site) {
	<details class="danger-zone"><summary>{ v.T("delete_permanently") }</summary><p class="hint">{ v.T("delete_site_warning") }</p><form action={ "/sites/" + site.ID + "/delete" } method="post"><input type="hidden" name="csrf" value={ v.CSRF }/><label>{ v.T("type_domain_confirm") }<input name="confirm" required placeholder={ site.Domain }/></label><p><button class="danger">@icon("trash")<span class="button-label">{ v.T("delete_site_data") }</span></button></p></form></details>
}

templ settingsPage(v view) {
	<section id="settings"><div class="roadmap-head"><h2>{ v.T("mail_server_settings") }</h2>
	if v.Mail.Enabled {
		<span class="badge running">{ v.T("enabled") }</span>
	} else {
		<span class="badge">{ v.T("disabled") }</span>
	}
	</div><p class="hint">{ v.T("smtp_global_hint") }</p>
	<form action="/settings/mail" method="post"><input type="hidden" name="csrf" value={ v.CSRF }/><label class="checkbox-label"><input type="checkbox" name="enabled" checked?={ v.Mail.Enabled }/> { v.T("enable_global_smtp") }</label><div class="file-tools"><div>
		<label>{ v.T("smtp_host") }<input name="smtp_host" value={ v.Mail.Host } placeholder="smtp.example.com" autocomplete="off"/></label><label>{ v.T("encryption") }<select name="smtp_encryption"><option value="starttls" selected?={ v.Mail.Encryption == "starttls" }>STARTTLS</option><option value="tls" selected?={ v.Mail.Encryption == "tls" }>TLS</option><option value="none" selected?={ v.Mail.Encryption == "none" }>{ v.T("none") }</option></select></label><label>{ v.T("username") }<input name="smtp_username" value={ v.Mail.Username } autocomplete="off"/></label><label>{ v.T("from_email") }<input type="email" name="smtp_from_email" value={ v.Mail.FromEmail } placeholder="hello@example.com"/></label>
	</div><div><label>{ v.T("port") }<input type="number" name="smtp_port" value={ portValue(v.Mail.Port) } placeholder="587" min="1" max="65535"/></label><label>{ v.T("sender_name") }<input name="smtp_from_name" value={ v.Mail.FromName } placeholder={ v.T("your_company") }/></label><label>{ v.T("password") }<input type="password" name="smtp_password" autocomplete="new-password" placeholder={ passwordPlaceholder(v) }/></label><p class="hint">{ v.T("password_encrypted_hint") }</p></div></div><button class="form-submit">@icon("check")<span class="button-label">{ v.T("save_mail_settings") }</span></button></form></section>
 @resourcePlanSettings(v)
}

templ activityPage(v view) {
	<section id="activity"><div class="roadmap-head"><h2>{ v.T("recent_activity") }</h2><span class="badge">{ fmt.Sprintf("%d %s", len(v.Activity), v.T("events")) }</span></div>
	if len(v.Activity) > 0 {
		<div class="table-wrap"><table><thead><tr><th>{ v.T("time") }</th><th>{ v.T("action") }</th><th>{ v.T("site") }</th><th>{ v.T("result") }</th></tr></thead><tbody>
		for _, entry := range v.Activity {
			<tr><td>{ formatTime(entry.Time) }</td><td>{ entry.Action }</td><td>
				if entry.Domain != "" {
					{ entry.Domain }
				} else {
					—
				}
			</td><td>
				if entry.Success {
					{ v.T("success") }
				} else {
					{ v.T("failed") }
				}
			</td></tr>
		}
		</tbody></table></div>
	} else {
		<p class="hint">{ v.T("activity_empty") }</p>
	}
	</section>
}

templ roadmapPage(v view) {
	<section class="roadmap" id="roadmap"><div class="roadmap-head"><h2>{ v.T("on_horizon") }</h2><span class="badge">{ v.T("coming_soon") }</span></div><p class="hint">{ v.T("roadmap_hint") }</p><div class="roadmap-grid">
		@future(v.T("sftp_access"), v.T("secure_file_transfer")) @future(v.T("automated_alerts"), v.T("server_health")) @future(v.T("image_upgrades"), v.T("container_versions")) @future(v.T("storage_quotas"), v.T("storage_quota_hint")) @future(v.T("scheduled_remote_backups"), v.T("protect_off_server")) @future(v.T("customer_accounts"), v.T("customer_workspaces"))
	</div></section>
}

templ future(title, help string) { <div class="future">{ title }<span>{ help }</span></div> }

templ filesPage(v filesView) {
	<!doctype html><html lang={ v.Language } dir={ v.Direction }>
	<head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>panel4wp · { v.T("file_manager") }</title><link rel="stylesheet" href="/assets/app.css?v=9"/><script src="/assets/htmx.min.js?v=8" defer></script><script src="/assets/app.js?v=8" defer></script></head>
	<body><div class="shell">@sidebar(v.Language, v.PagePath, v.Languages, v.T, v.CSRF, "files")
	<div class="workspace"><header class="file-topbar"><a class="icon-link" href={ templ.URL("/sites/" + v.Site.ID) }>@icon("arrow-left")<span>{ v.T("back_to_site") }</span></a><div class="eyebrow file-eyebrow">{ v.T("site_workspace") }</div><h1>{ v.T("file_manager") }</h1><p class="muted">{ v.Site.Domain } · wp-content</p></header>@alerts(v.Error, v.Message)
		<section class="file-manager">
			<div class="file-toolbar">
				<button type="button" data-modal-open="file-upload-modal">@icon("upload")<span class="button-label">{ v.T("upload_file") }</span></button>
				<button class="secondary" type="button" data-modal-open="folder-create-modal">@icon("folder-plus")<span class="button-label">{ v.T("create_directory") }</span></button>
				<form class="inline" action={ "/sites/" + v.Site.ID + "/download" } method="post" data-file-download-form><input type="hidden" name="csrf" value={ v.CSRF }/><input type="hidden" name="path" data-selected-path/><button class="secondary" disabled data-selection-action data-requires-file>@icon("download")<span class="button-label">{ v.T("download") }</span></button></form>
				<button class="secondary" type="button" disabled data-selection-action data-requires-mutable data-modal-open="file-move-modal">@icon("move")<span class="button-label">{ v.T("move") }</span></button>
				<button class="danger" type="button" disabled data-selection-action data-requires-mutable data-modal-open="file-delete-modal">@icon("trash")<span class="button-label">{ v.T("delete") }</span></button>
			</div>
			<div class="file-location"><div class="path">{ v.T("path") }: <code>/wp-content
				if v.CurrentPath != "" {
					/{ v.CurrentPath }
				}
			</code></div>
			if v.HasParent {
				<a class="button secondary" href={ templ.URL("/sites/" + v.Site.ID + "/files?path=" + url.QueryEscape(v.Parent)) }>@icon("arrow-up")<span class="button-label">{ v.T("parent_directory") }</span></a>
			}
			</div>
			<div class="table-wrap"><table class="file-table"><thead><tr><th>{ v.T("name") }</th><th>{ v.T("size") }</th><th>{ v.T("modified") }</th><th>{ v.T("type") }</th></tr></thead><tbody>
			for _, entry := range v.Entries {
				<tr tabindex="0" aria-selected="false" data-file-row data-file-path={ entry.Path } data-file-name={ entry.Name } data-file-type={ entry.Type }
					if entry.Type == "directory" {
						data-file-open={ "/sites/" + v.Site.ID + "/files?path=" + url.QueryEscape(entry.Path) }
					}
				><td><span class={ "file-entry file-entry-" + entry.Type }>
					if entry.Type == "directory" {
						@icon("files")
					} else if entry.Type == "file" {
						@icon("file")
					} else {
						@icon("link")
					}
					<span>{ entry.Name }</span></span></td><td>
					if entry.Type == "file" {
						{ formatBytes(entry.Size) }
					} else {
						—
					}
				</td><td>{ formatUnixTime(entry.Modified) }</td><td>{ entry.Type }</td></tr>
			}
			if len(v.Entries) == 0 {
				<tr><td colspan="4">{ v.T("directory_empty") }</td></tr>
			}
			</tbody></table></div>
			<p class="hint file-manager-hint">{ v.T("file_access_hint") }</p>
		</section>
		@fileContextMenu(v)
		@fileManagerDialogs(v)
	</div></div></body></html>
}

templ fileContextMenu(v filesView) {
	<div class="file-context-menu" role="menu" hidden data-file-context-menu>
		<button type="button" role="menuitem" data-context-open>@icon("open")<span>{ v.T("open") }</span></button>
		<button type="button" role="menuitem" data-context-download>@icon("download")<span>{ v.T("download") }</span></button>
		<button type="button" role="menuitem" data-context-mutable data-modal-open="file-move-modal">@icon("move")<span>{ v.T("move") }</span></button>
		<button class="danger" type="button" role="menuitem" data-context-mutable data-modal-open="file-delete-modal">@icon("trash")<span>{ v.T("delete") }</span></button>
	</div>
}

templ fileManagerDialogs(v filesView) {
	<dialog id="file-upload-modal" class="confirm-dialog file-dialog" aria-labelledby="file-upload-title"><div class="dialog-header"><div class="dialog-title">@icon("upload")<h3 id="file-upload-title">{ v.T("upload_file") }</h3></div><button class="secondary icon-button" type="button" data-modal-close aria-label={ v.T("cancel") }>@icon("close")</button></div>
		<form action={ "/sites/" + v.Site.ID + "/upload" } method="post" enctype="multipart/form-data" data-disable-on-submit data-progress-label={ v.T("in_progress") }><input type="hidden" name="csrf" value={ v.CSRF }/><input type="hidden" name="path" value={ v.CurrentPath }/><label>{ v.T("select_file") }<input type="file" name="file" required/></label><div class="dialog-actions"><button class="secondary" type="button" data-modal-close>{ v.T("cancel") }</button><button type="submit">@icon("upload")<span class="button-label">{ v.T("upload_max") }</span></button></div></form>
	</dialog>
	<dialog id="folder-create-modal" class="confirm-dialog file-dialog" aria-labelledby="folder-create-title"><div class="dialog-header"><div class="dialog-title">@icon("folder-plus")<h3 id="folder-create-title">{ v.T("create_directory") }</h3></div><button class="secondary icon-button" type="button" data-modal-close aria-label={ v.T("cancel") }>@icon("close")</button></div>
		<form action={ "/sites/" + v.Site.ID + "/mkdir" } method="post" data-disable-on-submit data-progress-label={ v.T("in_progress") }><input type="hidden" name="csrf" value={ v.CSRF }/><input type="hidden" name="path" value={ v.CurrentPath }/><label>{ v.T("directory_name") }<input name="name" required maxlength="120" placeholder="directory-name"/></label><div class="dialog-actions"><button class="secondary" type="button" data-modal-close>{ v.T("cancel") }</button><button type="submit">@icon("folder-plus")<span class="button-label">{ v.T("create") }</span></button></div></form>
	</dialog>
	<dialog id="file-move-modal" class="confirm-dialog file-dialog" aria-labelledby="file-move-title"><div class="dialog-header"><div class="dialog-title">@icon("move")<h3 id="file-move-title">{ v.T("move") }</h3></div><button class="secondary icon-button" type="button" data-modal-close aria-label={ v.T("cancel") }>@icon("close")</button></div>
		<form action={ "/sites/" + v.Site.ID + "/file-move" } method="post" data-disable-on-submit data-progress-label={ v.T("in_progress") }><input type="hidden" name="csrf" value={ v.CSRF }/><input type="hidden" name="path" data-selected-path/><p class="selected-file" data-selected-name></p><label>{ v.T("destination_folder") }<input name="destination" autocomplete="off" placeholder="uploads/2026"/></label><p class="hint">{ v.T("move_file_hint") }</p><div class="dialog-actions"><button class="secondary" type="button" data-modal-close>{ v.T("cancel") }</button><button type="submit">@icon("move")<span class="button-label">{ v.T("move") }</span></button></div></form>
	</dialog>
	<dialog id="file-delete-modal" class="confirm-dialog file-dialog" aria-labelledby="file-delete-title"><div class="dialog-header"><div class="dialog-title">@icon("trash")<h3 id="file-delete-title">{ v.T("confirm_delete") }</h3></div><button class="secondary icon-button" type="button" data-modal-close aria-label={ v.T("cancel") }>@icon("close")</button></div>
		<p class="dialog-warning" data-delete-question-template={ v.T("delete_file_question") } data-delete-question></p><form action={ "/sites/" + v.Site.ID + "/file-delete" } method="post" data-disable-on-submit data-progress-label={ v.T("in_progress") }><input type="hidden" name="csrf" value={ v.CSRF }/><input type="hidden" name="path" data-selected-path/><div class="dialog-actions"><button class="secondary" type="button" data-modal-close>{ v.T("cancel") }</button><button class="danger" type="submit">@icon("trash")<span class="button-label">{ v.T("confirm_delete") }</span></button></div></form>
	</dialog>
}


templ capacityOverview(v view) {
 <section class="capacity-summary">
 <h3>{ v.T("capacity_title") }</h3><p class="hint">{ v.T("capacity_hint") }</p>
 if v.Capacity != nil {
 <div class="overview">
 <div class="metric"><span>{ v.T("capacity_ram") }</span><strong>{ formatBytes(v.Capacity.AvailableMemoryBytes()) }</strong><small>{ v.T("capacity_total") }: { formatBytes(v.Capacity.MemoryBytes) }</small></div>
 <div class="metric"><span>{ v.T("capacity_cpu") }</span><strong>{ fmt.Sprintf("%.2f",v.Capacity.AvailableCPUs()) }</strong><small>{ v.T("capacity_total") }: { fmt.Sprintf("%g",v.Capacity.CPUs) }</small></div>
 <div class="metric"><span>{ v.T("capacity_disk") }</span><strong>{ formatBytes(min(v.Capacity.DockerDiskFreeBytes,v.Capacity.DataDiskFreeBytes)) }</strong><small>{ v.T("capacity_disk_hint") }</small></div>
 </div>
 } else {<p class="error">{ v.CapacityError }</p>}
 </section>
}

templ resourceFields(v view,r core.Resources) {
 <label>{ v.T("resource_plan") }<select name="plan" data-resource-plan><option value="small" selected?={ r.MemoryMB==384 && r.CPUs==.5 }>{ v.T("plan_small") } · 384 MiB · 0.5 CPU</option><option value="standard" selected?={ r.MemoryMB==768 && r.CPUs==1 }>{ v.T("plan_standard") } · 768 MiB · 1 CPU</option><option value="large" selected?={ r.MemoryMB==1536 && r.CPUs==2 }>{ v.T("plan_large") } · 1536 MiB · 2 CPUs</option>for _,plan := range v.Plans {
 <option value={ "saved-"+plan.ID }>{ plan.Name } · { strconv.Itoa(plan.Resources.MemoryMB) } MiB · { fmt.Sprintf("%g",plan.Resources.CPUs) } CPU</option>
 }
 <option value="custom" selected?={ resourcePlan(r)=="custom" }>{ v.T("plan_custom") }</option></select></label>
 <div class="form-grid" data-custom-resources>
 <label>{ v.T("resource_memory") }<input name="memory_mb" type="number" min="256" max="8192" step="1" required value={ strconv.Itoa(r.MemoryMB) }/></label>
 <label>{ v.T("resource_cpu") }<input name="cpus" type="number" min="0.25" max="8" step="0.25" required value={ fmt.Sprintf("%g",r.CPUs) }/></label>
 </div>
 <p class="hint">{ v.T("resources_per_container") }</p>
}

templ siteResourcesForm(v view,site core.Site) {
 <section class="resources-form"><h3>{ v.T("resources_title") }</h3>
 @capacityOverview(v)
 <p class="hint">{ v.T("resources_change_warning") }</p>
 if !operationPending(site) && site.HealthError=="" && (site.Status==core.StatusRunning || site.Status==core.StatusStopped) {
 <form action={ "/sites/"+site.ID+"/resources" } method="post" data-disable-on-submit data-progress-label={ v.T("in_progress") }>
 <input type="hidden" name="csrf" value={ v.CSRF }/>
 @resourceFields(v,core.SiteResources(site))
 <button class="form-submit" disabled?={ v.Capacity==nil }>@icon("check")<span class="button-label">{ v.T("resources_save") }</span></button>
 </form>
 } else { <p class="hint">{ v.T("resources_repair_first") }</p> }
 </section>
 @diskQuotaCapability(v)
}

templ diskQuotaCapability(v view) {
 <section class="resources-form disk-capability">
  <h3>{ v.T("disk_quota_title") } <span class="badge">{ v.T("disk_quota_not_enabled") }</span></h3>
  <p class="hint">{ v.T("disk_quota_scope") }</p>
  if v.DiskCapability==nil {
   <p class="form-error" role="status">{ v.T("disk_quota_check_failed") }</p>
  } else {
   if v.DiskCapability.WordPressFilesystem!="" {
    <p class="hint">{ v.T("disk_quota_filesystem") }: <b dir="ltr">{ v.DiskCapability.WordPressFilesystem+" / "+v.DiskCapability.DatabaseFilesystem }</b></p>
   }
   if v.DiskCapability.SupportsProjectQuotas() {
    <p class="hint">{ v.T("disk_quota_backend_supported") }</p>
   } else {
    <p class="hint">{ v.T(diskCapabilityReasonKey(v.DiskCapability.Reason)) }</p>
   }
  }
  <p class="hint">{ v.T("disk_quota_development") }</p>
  <a class="button secondary" href="https://github.com/kazemsoft/panel4wp/blob/main/docs/RESOURCES.md#hard-disk-quotas" target="_blank" rel="noopener noreferrer">@icon("link")<span>{ v.T("disk_quota_docs") }</span></a>
 </section>
}


templ resourcePlanSettings(v view) {
 <section class="form-card resources-plan-settings"><h2>{ v.T("plans_title") }</h2><p class="hint">{ v.T("plans_hint") }</p>
 <form action="/settings/resource-plans" method="post" data-disable-on-submit data-progress-label={ v.T("in_progress") }>
 <input type="hidden" name="csrf" value={ v.CSRF }/><input type="hidden" name="plan" value="custom"/>
 <label>{ v.T("plan_name") }<input name="name" required maxlength="60"/></label>
 <div class="form-grid"><label>{ v.T("resource_memory") }<input name="memory_mb" type="number" min="256" max="8192" required value="512"/></label><label>{ v.T("resource_cpu") }<input name="cpus" type="number" min="0.25" max="8" step="0.25" required value="0.5"/></label></div>
 <p class="hint">{ v.T("resources_per_container") }</p>
 <button class="form-submit">@icon("plus")<span class="button-label">{ v.T("plan_add") }</span></button>
 </form>
 if len(v.Plans)>0{
 <div class="table-wrap"><table><thead><tr><th>{ v.T("plan_name") }</th><th>{ v.T("resource_memory") }</th><th>{ v.T("resource_cpu") }</th><th>{ v.T("actions") }</th></tr></thead><tbody>
 for _,plan := range v.Plans {
 <tr><td>{ plan.Name }</td><td>{ strconv.Itoa(plan.Resources.MemoryMB) } MiB</td><td>{ fmt.Sprintf("%g",plan.Resources.CPUs) }</td><td><form action="/settings/resource-plans/delete" method="post" data-disable-on-submit data-progress-label={ v.T("in_progress") }><input type="hidden" name="csrf" value={ v.CSRF }/><input type="hidden" name="id" value={ plan.ID }/><button class="danger icon-button" title={ v.T("plan_delete") } aria-label={ v.T("plan_delete") }>@icon("trash")</button></form></td></tr>
 }
 </tbody></table></div>
 }
 </section>
}
